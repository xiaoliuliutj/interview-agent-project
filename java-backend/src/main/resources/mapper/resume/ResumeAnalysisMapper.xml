<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.interviewguide.resume.mapper.ResumeAnalysisMapper">
  <select id="findById" resultType="com.interviewguide.resume.domain.ResumeAnalysisEntity">SELECT * FROM resume_analyses WHERE id=#{id}</select>
  <select id="findByResumeIdOrderByCreatedAtDesc" resultType="com.interviewguide.resume.domain.ResumeAnalysisEntity">SELECT * FROM resume_analyses WHERE resume_id=#{resumeId} ORDER BY created_at DESC</select>
  <select id="findFirstByResumeIdOrderByCreatedAtDesc" resultType="com.interviewguide.resume.domain.ResumeAnalysisEntity">SELECT * FROM resume_analyses WHERE resume_id=#{resumeId} ORDER BY created_at DESC LIMIT 1</select>
  <select id="findByResumeIdInAndStatusIn" resultType="com.interviewguide.resume.domain.ResumeAnalysisEntity">SELECT * FROM resume_analyses WHERE resume_id IN <foreach collection="resumeIds" item="item" open="(" separator="," close=")">#{item}</foreach> AND status IN <foreach collection="statuses" item="item" open="(" separator="," close=")">#{item}</foreach></select>
  <insert id="insert" useGeneratedKeys="true" keyProperty="id">INSERT INTO resume_analyses (resume_id,target_role,status,overall_score,content_score,structure_score,skill_match_score,expression_score,project_score,summary,strengths_json,suggestions_json,issues_json,error,retry_count,last_attempt_at,created_at,updated_at) VALUES (#{resumeId},#{targetRole},#{status},#{overallScore},#{contentScore},#{structureScore},#{skillMatchScore},#{expressionScore},#{projectScore},#{summary},#{strengthsJson},#{suggestionsJson},#{issuesJson},#{error},#{retryCount},#{lastAttemptAt},#{createdAt},#{updatedAt})</insert>
  <update id="update">UPDATE resume_analyses SET status=#{status},overall_score=#{overallScore},content_score=#{contentScore},structure_score=#{structureScore},skill_match_score=#{skillMatchScore},expression_score=#{expressionScore},project_score=#{projectScore},summary=#{summary},strengths_json=#{strengthsJson},suggestions_json=#{suggestionsJson},issues_json=#{issuesJson},error=#{error},retry_count=#{retryCount},last_attempt_at=#{lastAttemptAt},updated_at=#{updatedAt} WHERE id=#{id}</update>
  <delete id="deleteByResumeId">DELETE FROM resume_analyses WHERE resume_id=#{resumeId}</delete>
</mapper>

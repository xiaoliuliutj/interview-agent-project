<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.interviewguide.interview.mapper.InterviewTurnMapper">
  <select id="findBySessionIdOrderByCreatedAt" resultType="com.interviewguide.interview.domain.InterviewTurnEntity">SELECT * FROM interview_turns WHERE session_id=#{sessionId} ORDER BY created_at</select>
  <insert id="upsert" useGeneratedKeys="true" keyProperty="id">INSERT INTO interview_turns (session_id,run_id,question,candidate_answer,stage,created_at,evaluation_summary,score,strengths_json,weaknesses_json) VALUES (#{sessionId},#{runId},#{question},#{candidateAnswer},#{stage},#{createdAt},#{evaluationSummary},#{score},#{strengthsJson},#{weaknessesJson})</insert>
  <delete id="deleteBySessionId">DELETE FROM interview_turns WHERE session_id=#{sessionId}</delete>
  <delete id="deleteAll">DELETE FROM interview_turns WHERE id IN <foreach collection="list" item="item" open="(" separator="," close=")">#{item.id}</foreach></delete>
</mapper>

POSTGRES_DB=interview_agent
POSTGRES_USER=interview
POSTGRES_PASSWORD=replace-with-a-strong-password

MODEL_PROVIDER=openai-compatible
MODEL_NAME=
MODEL_API_KEY=
MODEL_BASE_URL=
MODEL_TEMPERATURE=0.2
# 单次模型/Embedding 请求最多等待 120 秒；下层会在短暂网络故障时最多尝试 5 次。
REQUEST_TIMEOUT_SECONDS=120
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
AGENT_SYSTEM_KNOWLEDGE_BASE_IDS=
RABBITMQ_USER=interview
RABBITMQ_PASSWORD=replace-with-a-strong-password

# Java 到下层的等待时间必须覆盖下层的有限模型重试；业务/RabbitMQ 重试最多 2 次。
PYTHON_AGENT_READ_TIMEOUT=11m
AGENT_RABBIT_RETRY_MAX_ATTEMPTS=2
AGENT_MAX_ATTEMPTS=2

# Java 上层运行参数；Compose 已提供默认容器路径
AGENT_FILE_STORAGE_ROOT=/app/data/files
# 将真实字体放到 infrastructure/fonts/，不要提交字体文件。
AGENT_PDF_FONT_PATH=/app/fonts/NotoSansCJKsc-Regular.otf

# 可选：构建网络受限时配置企业内部镜像。
MAVEN_MIRROR_URL=
PIP_INDEX_URL=
NPM_REGISTRY=https://registry.npmjs.org/

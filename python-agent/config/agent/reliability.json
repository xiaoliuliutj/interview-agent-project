{
  "maxAttempts": 5,
  "attemptTimeoutSeconds": 120,
  "maxOutputCorrectionAttempts": 2,
  "initialBackoffMilliseconds": 200,
  "maxBackoffMilliseconds": 2000,
  "retryableErrors": [
    "TimeoutError",
    "ConnectError",
    "ConnectionError",
    "APIConnectionError",
    "APITimeoutError",
    "RateLimitError",
    "ServiceUnavailableError"
  ]

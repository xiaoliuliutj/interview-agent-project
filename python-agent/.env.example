# 复制为 .env 后填写；真实 .env 已被 .gitignore 忽略
MODEL_PROVIDER=openai-compatible
MODEL_NAME=
MODEL_API_KEY=
MODEL_BASE_URL=
MODEL_TEMPERATURE=0.2
MODEL_MAX_TOKENS=

# RAG 使用的 OpenAI-compatible Embedding 模型；没有 Embedding 服务时不要伪造配置
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# 生产必须配置 PostgreSQL（建议 asyncpg 驱动）
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/interview_agent

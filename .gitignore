# Local environment and secrets
.env
.env.*
!.env.example

# Java and Gradle
**/.gradle/
**/build/
**/target/
*.class

# Python
**/.venv/
**/venv/
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.mypy_cache/
.coverage
coverage/

# Node.js and frontend builds
**/node_modules/
**/dist/
.pnpm-store/

# IDE and editor files
.idea/
*.iml
.vscode/

# Runtime files
*.log
logs/

# Deployment-only fonts (the CJK font is supplied outside Git)
infrastructure/fonts/*
!infrastructure/fonts/.gitkeep

# Temporary assistant workspace
_scratch/*
!_scratch/.gitkeep

# Git bundle export artifacts
*.bundle

# Locally retained knowledge-base image assets
python-agent/config/rag/sources/java-interview-knowledge-base-assets/
